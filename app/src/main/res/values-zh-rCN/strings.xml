    <!-- region OnboardingScreen -->
    <string name="onboarding_info_1">"NotiFilter 会运行一个低资源占用的后台服务，监听设备上的所有通知，并按照您设定的过滤器静默处理。\n\n所有数据都留在您的设备中，NotiFilter 不会将数据上传到互联网。"</string>
    <string name="grant_permission">授予通知使用权限</string>
    <string name="onboarding_info_2">某些型号的设备上，“电池优化”会导致通知关闭延迟，因此您仍可能被首次通知打扰。\n\n部分厂商的优化较为激进，您可能需要稍后在应用设置中开启“任务栏常驻”。</string>
    <string name="disable_optimization">关闭电池优化</string>
    <!-- endregion -->

    <!-- region AboutScreen -->
    <string name="about">关于</string>
    <string name="app_description">" 会监听您设备上的所有通知，并按您设定的过滤器静默处理匹配的通知。"</string>
    <string name="app_links"><![CDATA[此项目遵循 <a href=\"https://github.com/BURG3R5/NotiFilter/blob/master/LICENSE\">GPLv3</a> 许可<br/>源代码托管于 <a href=\"https://github.com/BURG3R5/NotiFilter\">GitHub</a><br/>您可以访问 <a href=\"https://github.com/BURG3R5/NotiFilter/wiki\">项目 Wiki</a> 了解更多]]></string>
    <string name="app_permissions"><![CDATA[权限<small><ul><li>BIND_NOTIFICATION_LISTENER_SERVICE：监听并响应通知</li><li>QUERY_ALL_PACKAGES：添加过滤器时搜索已安装应用</li><li>BIND_ACCESSIBILITY_SERVICE：执行 TAP_NOTIFICATION 操作（如需要）</li><li>POST_NOTIFICATIONS：执行 ALERT/REPLACE 操作（如需要）</li><li>ACCESS_NOTIFICATION_POLICY：执行 DISTURB 操作（如需要）</li><li>REQUEST_IGNORE_BATTERY_OPTIMIZATIONS：执行 DISMISS_STALE 操作（如需要）</li><li>FOREGROUND_SERVICE_SPECIAL_USE：可选择将核心服务提升为前台，避免系统过度优化</li></ul>其他权限可能由第三方库用于管理任务，例如更新小组件。</small>]]></string>
    <string name="dev_credit"><![CDATA[由 <a href=\"https://github.com/BURG3R5/\">BURG3R5</a> 开发]]></string>

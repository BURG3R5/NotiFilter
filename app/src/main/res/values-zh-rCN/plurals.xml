<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <plurals name="hour">
        <item quantity="one">%1$d 小时</item>
        <item quantity="other">%1$d 小时</item>
    </plurals>
    <plurals name="minute">
        <item quantity="one">%1$d 分钟</item>
        <item quantity="other">%1$d 分钟</item>
    </plurals>
    <plurals name="second">
        <item quantity="one">%1$d 秒</item>
        <item quantity="other">%1$d 秒</item>
    </plurals>
    <plurals name="hit">
        <item quantity="one">%1$d 次命中</item>
        <item quantity="other">%1$d 次命中</item>
    </plurals>

    <!-- 这些虽然名为 string，实际是 ICU 复数表达式，结构需与复数保持一致 -->
    <string name="hour">{0, plural,
    =0 {0 小时}
    one {# 小时}
    other {# 小时}}
    </string>
    <string name="minute">{0, plural,
    =0 {0 分钟}
    one {# 分钟}
    other {# 分钟}}
    </string>
</resources>

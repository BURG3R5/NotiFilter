    <!-- region OnboardingScreen -->
    <string name="onboarding_info_1">"NotiFilter 會執行一個低資源占用的背景服務，監聽裝置上的所有通知，並依照您設定的篩選器靜默處理。\n\n所有資料都留在您的裝置中，NotiFilter 不會將資料上傳到網路。"</string>
    <string name="grant_permission">授予通知使用權限</string>
    <string name="onboarding_info_2">某些型號的裝置上，「電池最佳化」會導致通知關閉延遲，因此您仍可能被首次通知打擾。\n\n部分廠商的優化較為激進，您可能需要稍後在應用程式設定中開啟「工作列常駐」。</string>
    <string name="disable_optimization">關閉電池最佳化</string>
    <!-- endregion -->

    <!-- region AboutScreen -->
    <string name="about">關於</string>
    <string name="app_description">" 會監聽您裝置上的所有通知，並依照您設定的篩選器靜默處理符合的通知。"</string>
    <string name="app_links"><![CDATA[此專案遵循 <a href=\"https://github.com/BURG3R5/NotiFilter/blob/master/LICENSE\">GPLv3</a> 授權<br/>原始碼託管於 <a href=\"https://github.com/BURG3R5/NotiFilter\">GitHub</a><br/>您可以造訪 <a href=\"https://github.com/BURG3R5/NotiFilter/wiki\">專案 Wiki</a> 了解更多]]></string>
    <string name="app_permissions"><![CDATA[權限<small><ul><li>BIND_NOTIFICATION_LISTENER_SERVICE：監聽並回應通知</li><li>QUERY_ALL_PACKAGES：新增篩選器時搜尋已安裝的應用程式</li><li>BIND_ACCESSIBILITY_SERVICE：執行 TAP_NOTIFICATION 操作（如需）</li><li>POST_NOTIFICATIONS：執行 ALERT/REPLACE 操作（如需）</li><li>ACCESS_NOTIFICATION_POLICY：執行 DISTURB 操作（如需）</li><li>REQUEST_IGNORE_BATTERY_OPTIMIZATIONS：執行 DISMISS_STALE 操作（如需）</li><li>FOREGROUND_SERVICE_SPECIAL_USE：可選擇將核心服務提升為前景，避免系統過度優化</li></ul>其他權限可能由第三方函式庫用於管理工作，例如更新小工具。</small>]]></string>
    <string name="dev_credit"><![CDATA[由 <a href=\"https://github.com/BURG3R5/\">BURG3R5</a> 開發]]></string>

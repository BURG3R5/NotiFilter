    <!-- region OnboardingScreen -->
    <string name="onboarding_info_1">"NotiFilter 會運行一個低資源佔用的背景服務，監聽裝置上的所有通知，並按照您設定的過濾器靜默處理。\n\n所有數據都留在您的裝置中，NotiFilter 不會將數據上傳到互聯網。"</string>
    <string name="grant_permission">授予通知使用權限</string>
    <string name="onboarding_info_2">某些型號的裝置上，「電池優化」會導致通知關閉延遲，因此您仍可能被首次通知打擾。\n\n部分廠商的優化較為激進，您可能需要稍後在應用程式設定中開啟「工作欄常駐」。</string>
    <string name="disable_optimization">關閉電池優化</string>
    <!-- endregion -->

    <!-- region AboutScreen -->
    <string name="about">關於</string>
    <string name="app_description">" 會監聽您裝置上的所有通知，並按照您設定的過濾器靜默處理符合的通知。"</string>
    <string name="app_links"><![CDATA[此項目遵循 <a href=\"https://github.com/BURG3R5/NotiFilter/blob/master/LICENSE\">GPLv3</a> 許可<br/>源代碼託管於 <a href=\"https://github.com/BURG3R5/NotiFilter\">GitHub</a><br/>您可以訪問 <a href=\"https://github.com/BURG3R5/NotiFilter/wiki\">項目 Wiki</a> 了解更多]]></string>
    <string name="app_permissions"><![CDATA[權限<small><ul><li>BIND_NOTIFICATION_LISTENER_SERVICE：監聽並響應通知</li><li>QUERY_ALL_PACKAGES：新增過濾器時搜尋已安裝的應用程式</li><li>BIND_ACCESSIBILITY_SERVICE：執行 TAP_NOTIFICATION 操作（如需）</li><li>POST_NOTIFICATIONS：執行 ALERT/REPLACE 操作（如需）</li><li>ACCESS_NOTIFICATION_POLICY：執行 DISTURB 操作（如需）</li><li>REQUEST_IGNORE_BATTERY_OPTIMIZATIONS：執行 DISMISS_STALE 操作（如需）</li><li>FOREGROUND_SERVICE_SPECIAL_USE：可選擇將核心服務提升為前台，避免系統過度優化</li></ul>其他權限可能由第三方庫用於管理工作，例如更新小工具。</small>]]></string>
    <string name="dev_credit"><![CDATA[由 <a href=\"https://github.com/BURG3R5/\">BURG3R5</a> 開發]]></string>
